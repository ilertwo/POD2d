QWidget {
    background-color: #f0f0f0;
    color: #000000;
}
QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #aaaaaa;
    border-radius: 4px;
    padding: 4px;
}
QPushButton:hover {
    background-color: #d0d0d0;
}
QListWidget {
    background-color: #ffffff;
    border: 1px solid #cccccc;
}