QWidget {
    background-color: #2b2b2b;
    color: #ffffff;
}
QPushButton {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px;
}
QPushButton:hover {
    background-color: #505050;
}
QListWidget {
    background-color: #1e1e1e;
    border: 1px solid #444444;
}